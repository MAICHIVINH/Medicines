# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT VARIABLES) - WEBSITE TRA CỨU & QUẢN LÝ THUỐC
# ==============================================================================
# Sao chép file này thành `.env` cho môi trường Development hoặc cấu hình trên
# Vercel Project Settings -> Environment Variables cho môi trường Production.
# LƯU Ý BẢO MẬT: KHÔNG đặt tiền tố NEXT_PUBLIC_ cho bất kỳ biến bí mật nào.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Chuỗi kết nối Pooled Connection từ Neon Console (sử dụng PgBouncer `-pooler`)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Chuỗi kết nối Direct Connection từ Neon Console (dùng cho Prisma Migrations)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTH.JS (NEXTAUTH V5) AUTHENTICATION
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT Session (Tạo bằng lệnh: `npx auth secret` hoặc `openssl rand -base64 32`)
AUTH_SECRET="replace-with-secure-32-byte-base64-secret-key"

# URL gốc của ứng dụng (Development: http://localhost:3000, Production: https://your-domain.vercel.app)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. NEON OBJECT STORAGE (S3-COMPATIBLE)
# ------------------------------------------------------------------------------
# Thông tin xác thực và Endpoint S3 riêng cho từng Branch của Neon Object Storage
AWS_ACCESS_KEY_ID="your-neon-s3-access-key-id"
AWS_SECRET_ACCESS_KEY="your-neon-s3-secret-access-key"
AWS_ENDPOINT_URL_S3="https://br-example.storage.c-1.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"

# Tên Bucket mặc định theo tài liệu kiến trúc
S3_BUCKET_NAME="medicine-images"

# Chế độ truy cập Bucket trên Neon Object Storage:
# - "public_read": nếu bucket được cấu hình `{ access: 'public_read' }`
# - "private": nếu bucket để mặc định private (Hệ thống sẽ tự động sinh Presigned GET URL)
S3_BUCKET_ACCESS="public_read"

# ------------------------------------------------------------------------------
# 4. SEED INITIAL ADMIN ACCOUNT (Chỉ dùng khi chạy `npm run db:seed`)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@pharmacatalog.vn"
INITIAL_ADMIN_PASSWORD="Admin@SecurePassword2026!"
INITIAL_ADMIN_FULLNAME="Quản trị viên Hệ thống Dược điển"

