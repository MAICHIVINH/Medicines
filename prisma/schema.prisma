generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum MedicineStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

// -----------------------------------------------------------------------------
// 4.1. CATEGORIES (Quản lý danh mục thuốc, hỗ trợ cha-con)
// -----------------------------------------------------------------------------

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(255)
  description String?    @db.Text
  parentId    String?    @db.Uuid
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  createdBy   String?    @db.Uuid
  updatedBy   String?    @db.Uuid
  deletedAt   DateTime?  @db.Timestamptz(6)

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  medicines   Medicine[]

  @@index([parentId])
  @@index([isActive, deletedAt, sortOrder])
  @@index([slug])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// 4.2. MEDICINES (Quản lý thông tin thuốc)
// -----------------------------------------------------------------------------

model Medicine {
  id                     String          @id @default(uuid()) @db.Uuid
  categoryId             String          @db.Uuid
  name                   String          @db.VarChar(255)
  slug                   String          @unique @db.VarChar(255)
  activeIngredient       String          @db.VarChar(500)
  manufacturer           String          @db.VarChar(255)
  registrationNumber     String?         @db.VarChar(100)
  description            String?         @db.Text
  usageInformation       String?         @db.Text
  storageInformation     String?         @db.Text
  isPrescriptionRequired Boolean         @default(false)
  status                 MedicineStatus  @default(DRAFT)
  isFeatured             Boolean         @default(false)
  publishedAt            DateTime?       @db.Timestamptz(6)
  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)
  createdBy              String?         @db.Uuid
  updatedBy              String?         @db.Uuid
  deletedAt              DateTime?       @db.Timestamptz(6)

  category               Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants               MedicineVariant[]
  images                 MedicineImage[]

  @@index([categoryId])
  @@index([status, deletedAt, isFeatured])
  @@index([status, deletedAt, publishedAt])
  @@index([name])
  @@index([activeIngredient])
  @@index([manufacturer])
  @@map("medicines")
}

// -----------------------------------------------------------------------------
// 4.3. MEDICINE IMAGES (Quản lý hình ảnh thuốc và biến thể trên Neon Object Storage)
// -----------------------------------------------------------------------------

model MedicineImage {
  id                String           @id @default(uuid()) @db.Uuid
  medicineId        String           @db.Uuid
  medicineVariantId String?          @db.Uuid
  bucketName        String           @db.VarChar(100)
  objectKey         String           @db.VarChar(500)
  publicUrl         String?          @db.Text
  fileName          String           @db.VarChar(255)
  mimeType          String           @db.VarChar(100)
  fileSize          Int
  isPrimary         Boolean          @default(false)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)

  medicine          Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  variant           MedicineVariant? @relation(fields: [medicineVariantId], references: [id], onDelete: SetNull)

  @@index([medicineId, isPrimary, sortOrder])
  @@index([medicineVariantId, isPrimary])
  @@index([objectKey])
  @@map("medicine_images")
}

// -----------------------------------------------------------------------------
// 4.4. MEDICINE VARIANTS (Quản lý biến thể thuốc)
// -----------------------------------------------------------------------------

model MedicineVariant {
  id              String                  @id @default(uuid()) @db.Uuid
  medicineId      String                  @db.Uuid
  sku             String                  @unique @db.VarChar(100)
  name            String                  @db.VarChar(255)
  price           Decimal                 @db.Decimal(18, 2)
  status          VariantStatus           @default(ACTIVE)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?               @db.Timestamptz(6)

  medicine        Medicine                @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  images          MedicineImage[]
  attributeValues VariantAttributeValue[]

  @@index([medicineId, status, deletedAt])
  @@index([price])
  @@index([sku])
  @@map("medicine_variants")
}

// -----------------------------------------------------------------------------
// 4.5. VARIANT ATTRIBUTES (Quản lý thuộc tính động)
// -----------------------------------------------------------------------------

model VariantAttribute {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String                  @db.VarChar(150)
  code         String                  @unique @db.VarChar(100)
  dataType     AttributeDataType       @default(TEXT)
  unit         String?                 @db.VarChar(50)
  isFilterable Boolean                 @default(false)
  isRequired   Boolean                 @default(false)
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(6)

  options      VariantAttributeOption[]
  values       VariantAttributeValue[]

  @@index([isActive, isFilterable, sortOrder])
  @@index([code])
  @@map("variant_attributes")
}

// -----------------------------------------------------------------------------
// 4.6. VARIANT ATTRIBUTE OPTIONS (Tùy chọn cho thuộc tính dạng SELECT)
// -----------------------------------------------------------------------------

model VariantAttributeOption {
  id                 String                  @id @default(uuid()) @db.Uuid
  variantAttributeId String                  @db.Uuid
  value              String                  @db.VarChar(255)
  label              String                  @db.VarChar(255)
  sortOrder          Int                     @default(0)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)

  attribute          VariantAttribute        @relation(fields: [variantAttributeId], references: [id], onDelete: Cascade)
  attributeValues    VariantAttributeValue[]

  @@unique([variantAttributeId, value])
  @@index([variantAttributeId, isActive, sortOrder])
  @@map("variant_attribute_options")
}

// -----------------------------------------------------------------------------
// 4.7. VARIANT ATTRIBUTE VALUES (Giá trị thuộc tính của từng biến thể)
// Một thuộc tính chỉ được xuất hiện một lần trong cùng một biến thể.
// -----------------------------------------------------------------------------

model VariantAttributeValue {
  id                       String                  @id @default(uuid()) @db.Uuid
  medicineVariantId        String                  @db.Uuid
  variantAttributeId       String                  @db.Uuid
  variantAttributeOptionId String?                 @db.Uuid
  textValue                String?                 @db.Text
  numberValue              Decimal?                @db.Decimal(18, 4)
  booleanValue             Boolean?
  createdAt                DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(6)

  variant                  MedicineVariant         @relation(fields: [medicineVariantId], references: [id], onDelete: Cascade)
  attribute                VariantAttribute        @relation(fields: [variantAttributeId], references: [id], onDelete: Restrict)
  option                   VariantAttributeOption? @relation(fields: [variantAttributeOptionId], references: [id], onDelete: Restrict)

  @@unique([medicineVariantId, variantAttributeId])
  @@index([variantAttributeId, variantAttributeOptionId])
  @@index([variantAttributeId, textValue])
  @@index([variantAttributeId, numberValue])
  @@index([variantAttributeId, booleanValue])
  @@map("variant_attribute_values")
}

// -----------------------------------------------------------------------------
// 4.8. ADMIN ACCOUNTS (Hệ thống chỉ có 1 tài khoản Admin duy nhất)
// -----------------------------------------------------------------------------

model AdminAccount {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(255)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@map("admin_accounts")
}

